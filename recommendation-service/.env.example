# ==================== LLM 配置（OpenAI 兼容，可选） ====================
# 与 agent-service 约定一致；三者齐备时启用 LLM 润色主动触达文案，
# 否则回退规则模板文案（服务功能不受影响）。
# 支持 OpenAI / DeepSeek / vLLM / Ollama 等任意 OpenAI 兼容服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
LLM_TIMEOUT=60

# ==================== 内部服务鉴权 ====================
# 为空时跳过鉴权（仅本地开发）；配置后调用 /internal/v1/* 需携带
# x-service-token 请求头。
SERVICE_TOKEN=

# ==================== 消息推送（可选） ====================
# 配置后，触发点匹配产生的多方消息会 POST 到该 Webhook（如后端消息网关）；
# 为空时消息仅随接口返回（delivery=returned），由后端自行投递。
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
PUSH_TIMEOUT=10

# ==================== 检索服务（可选） ====================
# 配置后优先调用 retrieval-service 向量检索；为空时回退本地关键词检索。
RETRIEVAL_SERVICE_URL=
RETRIEVAL_SERVICE_TIMEOUT=30

# ==================== 专利数据（本地兜底） ====================
# 默认读取仓库内 agent-service/milvus.json，可按需覆盖为绝对路径。
PATENT_DATA_PATH=

# ==================== 推荐 / 主动触达参数（均有默认值，可不配） ====================
RECOMMEND_DEFAULT_TOP_K=6
RECOMMEND_MAX_TOP_K=10
PROACTIVE_NEW_PATENT_DAYS=30
PROACTIVE_HOT_VIEW_THRESHOLD=100
PROACTIVE_HOT_POOL_SIZE=50
PROACTIVE_MIN_MATCH_SCORE=1.0
PROACTIVE_CONVERSATION_TOP_K=3
PROACTIVE_MAX_PUSH_PER_USER=5
PROACTIVE_PROMOTE_TOP_K=5
