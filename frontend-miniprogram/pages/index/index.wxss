/* ========== 和账户中心完全一样的流式布局 ========== */
.page-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.segment-tabs {
  background: white;
  border-bottom: 1px solid #eee;
  padding: 10px 0 0;
  white-space: nowrap;
}

.tabs-container {
  display: inline-flex;
  padding: 0 16px;
}

.tab-item {
  flex-shrink: 0;
  padding: 0 16px;
  text-align: center;
  font-size: 14px;
  color: #666;
  padding-bottom: 10px;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
}

.tab-item.active {
  color: #07c160;
  font-weight: 500;
  border-bottom-color: #07c160;
}

.common-page {
  padding: 0px;
  min-height: 100%;
}

.ai-area {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
}

.ai-area.has-tabs {
  top: 44px;
}

.msg-scroll-view {
  flex: 1;
  padding: 16px;
  padding-top: 16px;
  box-sizing: border-box;
  height: calc(100vh - 120px);
}

.ai-input-bar {
  background: #fff;
  padding: 10px 12px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1px solid #e5e5e5;
  box-sizing: border-box;
  flex-shrink: 0;
  margin-bottom: 0px;
}

/* ========== 通用消息/按钮样式 ========== */
.input-text {
  flex: 1;
  background: #f5f5f5;
  border: 1px solid #e6e6e6;
  border-radius: 4px;
  padding: 8px 12px;
  font-size: 15px;
  line-height: 20px;
  height: 20px;
  margin-right: 6px;
}

.btn-send {
  width: 50px;
  min-width: 50px;
  max-width: 50px;
  background: #07c160;
  color: white;
  border-radius: 4px;
  font-size: 14px;
  height: 36px;
  line-height: 36px;
  padding: 0;
  margin: 0;
  border: none;
  text-align: center;
}

.btn-send::after { border: none; content: ''; display: none; }
.btn-send[disabled] { background: #b8e5c6; color: #83d29f; }

.msg-item {
  display: flex;
  margin-bottom: 20px;
}

.user-msg { justify-content: flex-end; }
.user-msg .msg-content {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  padding: 12px 16px;
  border-radius: 16px 16px 4px 16px;
  max-width: 70%;
  line-height: 1.6;
}

.ai-msg { justify-content: flex-start; align-items: flex-start; }

.ai-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: white;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex-shrink: 0;
}

.ai-msg .msg-content {
  flex: 1;
  background: white;
  padding: 14px 16px;
  border-radius: 4px 16px 16px 16px;
  line-height: 1.6;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  max-width: calc(100% - 50px);
}

.patent-cards {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.patent-card {
  background: linear-gradient(135deg, #f0f7ff, #e6f0ff);
  border-radius: 12px;
  padding: 14px;
  border: 1px solid #d6e8ff;
}

.patent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.patent-name {
  font-size: 15px;
  font-weight: 600;
  color: #1677ff;
  flex: 1;
  padding-right: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fit-rate {
  font-size: 12px;
  color: white;
  background: linear-gradient(135deg, #00b42a, #009a29);
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 500;
  white-space: nowrap;
}

.patent-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.patent-tags .tag {
  font-size: 11px;
  background: white;
  color: #1677ff;
  padding: 3px 10px;
  border-radius: 4px;
  border: 1px solid #bad6ff;
}

.recommend-reason {
  font-size: 12px;
  color: #666;
  line-height: 1.5;
}

.recommend-reason .label {
  color: #333;
  font-weight: 500;
  margin-right: 4px;
}

.loading-msg {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.typing {
  background: white;
  padding: 14px 16px;
  border-radius: 4px 16px 16px 16px;
  margin-left: 10px;
  display: flex;
  gap: 4px;
}

.typing .dot {
  width: 6px;
  height: 6px;
  background: #999;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-6px); }
}

/* ========== 专利筛选样式 ========== */
.search-area {
  background: white;
  padding: 12px 16px;
  border-bottom: 1px solid #eee;
  border-radius: 12px;
  margin-bottom: 12px;
}

.search-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 4px;
  padding: 10px 14px;
  font-size: 14px;
}

.search-btn {
  background: #07c160;
  color: white;
  border-radius: 4px;
  font-size: 14px;
  padding: 0 18px;
  height: 38px;
  line-height: 38px;
  margin: 0;
  border: none;
}

.search-btn::after { border: none; }

.filter-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.filter-label {
  font-size: 13px;
  color: #666;
  line-height: 26px;
  white-space: nowrap;
  width: 65px;
}

.filter-options {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.chip {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 12px;
  background: #f5f5f5;
  color: #666;
  border: 1px solid transparent;
}

.chip.active {
  background: #f0f5ff;
  color: #1677ff;
  border-color: #adc6ff;
}

.result-list {
  padding-bottom: 20px;
}

.result-item {
  background: white;
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 10px;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.patent-title {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  flex: 1;
  padding-right: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-box {
  padding: 60px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 40px;
  display: block;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #999;
}

.loading-more {
  padding: 20px;
  text-align: center;
}

.loading-text {
  font-size: 13px;
  color: #ccc;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.item-abstract {
  font-size: 12px;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8px;
}

.item-tags .tag {
  font-size: 11px;
  background: #f5f5f5;
  color: #999;
  padding: 2px 7px;
  border-radius: 3px;
}

.item-desc {
  font-size: 13px;
  color: #999;
  line-height: 1.5;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #ccc;
}

/* ========== 空状态 ========== */
.empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
}

.empty-view .tip-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-view .tip-text {
  font-size: 14px;
  color: #999;
}

.empty-view .tip-desc {
  font-size: 12px;
  color: #ccc;
  margin-top: 6px;
}



/* ========== 数据看板样式 ========== */
.dashboard-page {
  padding: 16px;
  background-color: #f5f7fa;
  min-height: 100%;
}

.dashboard-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx 0 rgba(0, 0, 0, 0.08);
}

.dashboard-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.dashboard-subtitle {
  font-size: 26rpx;
  font-weight: 600;
  color: #303133;
  margin: 24rpx 0 16rpx 0;
}

.stats-container {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.chart-container {
  width: 100%;
  height: 320rpx;
  background-color: white;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.analysis-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dashboard-card-inner {
  background-color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx 0 rgba(0, 0, 0, 0.06);
}

.table-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
  overflow-x: auto;
}

.table {
  display: table;
  min-width: 100%;
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
}

.table-header {
  display: table-row;
  background-color: #f5f7fa;
}

.table-row {
  display: table-row;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  display: table-cell;
  font-size: 22rpx;
  padding: 16rpx 12rpx;
  border-bottom: 2rpx solid #f0f2f5;
  vertical-align: middle;
}

.rank-cell {
  width: 60rpx;
  text-align: center;
  color: #409eff;
  font-weight: 600;
}

.field-cell {
  width: 180rpx;
  color: #303133;
}

.count-cell {
  width: 100rpx;
  text-align: center;
  color: #606266;
}

.title-cell {
  width: 350rpx;
  color: #303133;
  white-space: normal;
  word-break: break-all;
  vertical-align: top;
  padding-top: 16rpx;
}

.views-cell {
  width: 100rpx;
  text-align: center;
  color: #606266;
}

.table-header .table-cell {
  font-weight: 600;
  color: #606266;
  border-bottom: 2rpx solid #e4e7ed;
  background-color: #f5f7fa;
}


/* ========== 管理后台样式 ========== */
.admin-page {
  background: #f5f7fa;
  min-height: 100%;
}

.admin-page .toolbar {
  background: white;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 8px;
  margin-bottom: 12px;
}

.user-filter {
  flex: 1;
}

.picker-box {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  background: #f5f5f5;
  border-radius: 6px;
  font-size: 13px;
  color: #333;
}

.picker-arrow {
  margin-left: 8px;
  font-size: 10px;
  color: #999;
}

.add-btn {
  background: #07c160;
  color: white;
  font-size: 13px;
  padding: 6px 16px;
  border-radius: 6px;
  border: none;
}

.admin-page .list-section {
  padding: 0;
}

.admin-page .list {
  background: white;
  border-radius: 8px;
  overflow: hidden;
}

.admin-page .list-item {
  display: flex;
  align-items: center;
  padding: 14px;
  border-bottom: 1px solid #f0f0f0;
}

.admin-page .list-item:last-child {
  border-bottom: none;
}

.item-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 16px;
  font-weight: 500;
  margin-right: 12px;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  display: block;
}

.item-meta {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 4px;
}

.item-actions {
  display: flex;
  gap: 10px;
}

.action-btn {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 4px;
}

.action-btn.edit {
  background: #e8f5e9;
  color: #07c160;
}

.action-btn.delete {
  background: #ffebee;
  color: #ff5252;
}

.action-btn.upgrade {
  background: #e3f2fd;
  color: #1976d2;
}

.admin-page .loading-box {
  padding: 60px 20px;
  text-align: center;
}

.admin-page .empty-box {
  padding: 40px 20px;
  text-align: center;
}

.admin-page .pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding: 20px;
}

.page-btn {
  font-size: 14px;
  color: #1976d2;
}

.page-btn.disabled {
  color: #ccc;
}

.page-info {
  font-size: 13px;
  color: #666;
}

/* ========== 弹窗样式 ========== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 340px;
  background: white;
  border-radius: 12px;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #eee;
}

.modal-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 24px;
  color: #999;
  line-height: 1;
}

.modal-body {
  max-height: 60vh;
  padding: 16px;
}

/* 角色权限网格样式 */
.permission-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.permission-item {
  width: calc(50% - 5px);
  padding: 12px;
  border-radius: 8px;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.permission-item.active {
  background: #e8f5e9;
}

.permission-label {
  font-size: 13px;
  color: #333;
  font-weight: 500;
}

.permission-status {
  font-size: 12px;
  color: #999;
}

.permission-item.active .permission-status {
  color: #07c160;
}

.detail-item {
  display: flex;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.detail-label {
  width: 80px;
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 13px;
  color: #333;
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  font-size: 13px;
  color: #666;
  display: block;
  margin-bottom: 8px;
}

.patent-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 6px;
  padding: 0 12px;
  height: 38px;
}

.search-input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 14px;
}

.search-btn {
  color: #07c160;
  font-size: 14px;
  font-weight: 500;
  padding-left: 12px;
  border-left: 1px solid #ddd;
}

.form-input {
  width: 100%;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  min-height: 100px;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 10px;
  padding: 16px;
  border-top: 1px solid #eee;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 10px;
  border-radius: 6px;
  font-size: 14px;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #07c160;
  color: white;
}

/* ========== 消息管理样式 ========== */
.message-page .tabs {
  background: white;
  display: flex;
  border-bottom: 1px solid #eee;
}

.message-page .tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #666;
  border-bottom: 2px solid transparent;
}

.message-page .tab-item.active {
  color: #07c160;
  border-bottom-color: #07c160;
}

.message-page .content {
  padding: 10px;
}

.message-page .list {
  background: white;
  border-radius: 8px;
  overflow: hidden;
}

.message-page .list-item {
  padding: 14px;
  border-bottom: 1px solid #f0f0f0;
}

.message-page .list-item:last-child {
  border-bottom: none;
}

/* ========== 角色管理页面样式 ========== */
.role-page .toolbar {
  background: white;
  padding: 10px 16px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  border-radius: 8px;
  margin-bottom: 12px;
}

.role-page .list-section {
  padding: 0;
}

.role-page .list {
  background: white;
  border-radius: 8px;
  overflow: hidden;
}

.role-page .list-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  background: white;
}

.role-page .list-item:last-child {
  border-bottom: none;
}

.role-page .item-info {
  flex: 1;
  min-width: 0;
}

.role-page .item-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 6px;
}

.role-page .item-meta {
  font-size: 13px;
  color: #666;
  display: block;
  margin-top: 4px;
  line-height: 1.4;
}

.role-page .permission-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.role-page .permission-tag {
  font-size: 11px;
  padding: 3px 8px;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 4px;
}

.role-page .item-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.role-page .action-btn {
  font-size: 13px;
  padding: 6px 14px;
  border-radius: 6px;
  font-weight: 500;
}

.role-page .action-btn.edit {
  background: #e8f5e9;
  color: #07c160;
}

.role-page .action-btn.delete {
  background: #ffebee;
  color: #ff5252;
}

.role-page .loading-box {
  padding: 60px 20px;
  text-align: center;
}

.role-page .empty-box {
  padding: 40px 20px;
  text-align: center;
}

.role-page .empty-text {
  color: #999;
  font-size: 14px;
}
