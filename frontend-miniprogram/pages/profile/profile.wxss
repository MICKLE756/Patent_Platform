.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 16px;
}

.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16px;
  padding: 24px;
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.avatar-box {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 28px;
  font-weight: 600;
  color: #667eea;
}

.user-info {
  margin-left: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 19px;
  font-weight: 600;
  color: white;
  margin-bottom: 10px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.user-id {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
}

.user-role {
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 10px;
  font-weight: 500;
}

.role-normal { background: rgba(255,255,255,0.25); color: white; }
.role-assistant { background: #07c160; color: white; }
.role-team { background: #1677ff; color: white; }
.role-admin { background: #ff4d4f; color: white; }

.menu-list {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 20px;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f9fa;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 22px;
  height: 22px;
  margin-right: 12px;
}

.menu-text {
  font-size: 15px;
  color: #333;
}

.arrow-icon {
  width: 16px;
  height: 16px;
  opacity: 0.4;
}

.logout-section {
  margin-top: 20px;
}

.logout-btn {
  background: white;
  color: #ff4d4f;
  border-radius: 12px;
  font-size: 16px;
  height: 50px;
  line-height: 50px;
  border: none;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #fff1f0;
}
