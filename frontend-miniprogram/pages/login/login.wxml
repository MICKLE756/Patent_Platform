<view class="login-container">
  <view class="logo-section">
    <view class="logo">
      <text class="logo-text">专利平台</text>
    </view>
    <view class="welcome-text">
      <text>欢迎登录专利智能平台</text>
    </view>
  </view>

  <view class="login-section">
    <!-- 微信快捷登录模式 -->
    <view wx:if="{{loginMode === 'wechat'}}" class="login-form">
      <button 
        class="wechat-login-btn" 
        bindtap="doRealLogin"
        loading="{{loading}}"
      >
        <text>{{loading ? '登录中...' : '微信快捷登录'}}</text>
      </button>
    </view>

    <!-- 账号密码登录模式 -->
    <view wx:if="{{loginMode === 'password'}}" class="login-form">
      <view class="input-item">
        <text class="input-label">用户名</text>
        <input 
          class="input-field" 
          placeholder="请输入用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      <view class="input-item">
        <text class="input-label">密码</text>
        <input 
          class="input-field" 
          placeholder="请输入密码" 
          value="{{password}}"
          password
          bindinput="onPasswordInput"
        />
      </view>
      <button 
        class="password-login-btn" 
        bindtap="doPasswordLogin"
        loading="{{loading}}"
        disabled="{{!canLogin}}"
      >
        <text>{{loading ? '登录中...' : '登录'}}</text>
      </button>
    </view>

    <view class="privacy-text">
      <text>登录即表示同意</text>
      <navigator url="" class="link">《用户协议》</navigator>
      <text>和</text>
      <navigator url="" class="link">《隐私政策》</navigator>
    </view>

    <view class="login-switch">
      <text 
        class="switch-link" 
        bindtap="switchLoginMode"
      >{{loginMode === 'wechat' ? '通过账密登录' : '使用微信快捷登录'}}</text>
    </view>
  </view>
</view>