.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
}

.logo-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.logo {
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.logo-text {
  font-size: 28px;
  font-weight: bold;
  color: white;
}

.welcome-text {
  text-align: center;
}

.welcome-text text {
  font-size: 20px;
  color: white;
  font-weight: 500;
}

.login-section {
  background: white;
  border-radius: 24px 24px 0 0;
  padding: 40px 30px; 
  padding-bottom: calc(30px + env(safe-area-inset-bottom));
}

.login-form {
  margin-bottom: 20px;
}

.input-item {
  margin-bottom: 20px;
}

.input-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
  display: block;
}

.input-field {
  width: 100%;
  height: 48px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 14px;
  box-sizing: border-box;
}

.wechat-login-btn {
  background: #07c160 !important;
  color: white !important;
  border-radius: 12px;
  font-size: 16px;
  height: 52px;
  line-height: 52px;
  border: none;
  padding-left: 20px;
  padding-right: 20px;
}

.wechat-login-btn::after {
  border: none;
}

.password-login-btn {
  background: #1677ff !important;
  color: white !important;
  border-radius: 12px;
  font-size: 16px;
  height: 52px;
  line-height: 52px;
  border: none;
  padding-left: 20px;
  padding-right: 20px;
}

.password-login-btn::after {
  border: none;
}

.password-login-btn[disabled] {
  background: #ccc !important;
  color: #999 !important;
}

.privacy-text {
  text-align: center;
  font-size: 12px;
  color: #999;
  line-height: 1.5;
}

.privacy-text .link {
  color: #1677ff;
  display: inline;
}

.login-switch {
  margin-top: 24px;
  text-align: center;
}

.switch-link {
  font-size: 13px;
  color: #1677ff;
  text-decoration: underline;
}