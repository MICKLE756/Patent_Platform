.app-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 10px;
}

.profile-section {
  margin-bottom: 15px;
}

.profile-card {
  background: white;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
}

.avatar-container {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 12px;
}

.avatar {
  width: 100%;
  height: 100%;
}

.team-name {
  font-size: 17px;
  font-weight: bold;
  margin-bottom: 6px;
  color: #333;
}

.team-institution {
  font-size: 13px;
  color: #666;
}

.tabs-section {
  background: white;
  border-radius: 12px;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.tabs {
  display: flex;
  border-bottom: 1px solid #f0f0f0;
}

.tab-button {
  flex: 1;
  padding: 14px;
  text-align: center;
  font-size: 14px;
  color: #666;
  position: relative;
}

.tab-button.active {
  color: #007aff;
  font-weight: bold;
}

.tab-button.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 3px;
  background-color: #007aff;
  border-radius: 2px;
}

.tab-content {
  padding: 12px;
  min-height: 200px;
}

.patents-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.empty-patents {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50px 10px 30px;
}

.empty-icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #333;
  margin-bottom: 6px;
}

.empty-desc {
  font-size: 12px;
  color: #999;
}

.patent-item {
  padding: 14px;
  background: #f9f9f9;
  border-radius: 8px;
  border-left: 3px solid #007aff;
}

.patent-title {
  font-size: 14px;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.patent-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-item {
  font-size: 12px;
  color: #999;
}

.messages-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.message-item {
  padding: 14px;
  background: #f9f9f9;
  border-radius: 8px;
  border-left: 3px solid #ff9500;
}

.message-sender {
  font-size: 13px;
  font-weight: bold;
  color: #333;
  margin-bottom: 6px;
}

.message-title {
  font-size: 12px;
  color: #666;
  line-height: 1.4;
}
