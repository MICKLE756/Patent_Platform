/* pages/dashboard/dashboard.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx 0 rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 30rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin: 30rpx 0 20rpx 0;
}

.stats-container {
  display: flex;
  gap: 30rpx;
}

.stat-item {
  flex: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.chart-container {
  width: 100%;
  height: 400rpx;
  background-color: white;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.analysis-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.table-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
  overflow-x: auto;
  scrollbar-width: thin;
  scrollbar-color: #409eff #f0f2f5;
}

.table-scroll::-webkit-scrollbar {
  height: 8rpx;
}

.table-scroll::-webkit-scrollbar-track {
  background: #f0f2f5;
  border-radius: 4rpx;
}

.table-scroll::-webkit-scrollbar-thumb {
  background: #409eff;
  border-radius: 4rpx;
}

.table-scroll::-webkit-scrollbar-thumb:hover {
  background: #66b1ff;
}

.table {
  display: table;
  min-width: 100%;
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx 0 rgba(0, 0, 0, 0.06);
}

.table-header {
  display: table-row;
  background-color: #f5f7fa;
}

.table-row {
  display: table-row;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  display: table-cell;
  font-size: 24rpx;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #f0f2f5;
  vertical-align: middle;
}

.rank-cell {
  width: 80rpx;
  text-align: center;
  color: #409eff;
  font-weight: 600;
}

.field-cell {
  width: 200rpx;
  color: #303133;
}

.count-cell {
  width: 120rpx;
  text-align: center;
  color: #606266;
}

.title-cell {
  width: 400rpx;
  color: #303133;
  white-space: normal;
  word-break: break-all;
  vertical-align: top;
  padding-top: 20rpx;
}

.views-cell {
  width: 120rpx;
  text-align: center;
  color: #606266;
}

.table-header .table-cell {
  font-weight: 600;
  color: #606266;
  border-bottom: 2rpx solid #e4e7ed;
  background-color: #f5f7fa;
}
