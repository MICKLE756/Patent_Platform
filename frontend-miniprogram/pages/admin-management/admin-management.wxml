<view class="container"><view class="tabs"><text class="tab-item {{activeTab==='user'?'active':''}}" bindtap="onTabChange" data-key="user">用户管理</text><text class="tab-item {{activeTab==='patent'?'active':''}}" bindtap="onTabChange" data-key="patent" wx:if="{{showPatentTab}}">专利管理</text></view><view class="toolbar"><view class="user-filter" wx:if="{{activeTab==='user'}}"><picker mode="selector" range="{{userTypeOptions}}" range-key="label" bindchange="onUserTypeChange"><view class="picker-box"><text>{{userTypeOptions[userTypeIndex].label}}</text><text class="picker-arrow">▼</text></view></picker></view><button class="add-btn" bindtap="openCreateModal" wx:if="{{canAddUser}}">新增用户</button><button class="add-btn" bindtap="openCreateModal" wx:if="{{canAddPatent}}">新增专利</button></view><view class="loading-box" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view><view class="content" wx:else><view wx:if="{{activeTab==='user'}}"><view class="list"><view class="list-item" wx:for="{{userList}}" wx:key="id"><view class="item-avatar"><text>{{item.avatarChar}}</text></view><view class="item-info" bindtap="openDetailModal" data-item="{{item}}"><text class="item-name">{{item.displayName}}</text><text class="item-meta">{{item.userTypeDisplay}} | {{item.statusLabel}}</text><text class="item-meta" wx:if="{{item.contactPhone}}">{{item.contactPhone}}</text></view><view class="item-actions"><text class="action-btn upgrade" wx:if="{{item.userType===0 && permissions.permissionSystemConfig===1}}" bindtap="upgradeToAdmin" data-item="{{item}}">升级</text><text class="action-btn edit" wx:if="{{item.userType===1 && permissions.permissionEnterpriseEdit===1}}" bindtap="openEditModal" data-item="{{item}}">编辑</text><text class="action-btn edit" wx:if="{{item.userType===2 && permissions.permissionResearchEdit===1}}" bindtap="openEditModal" data-item="{{item}}">编辑</text><text class="action-btn delete" wx:if="{{item.userType===1 && permissions.permissionEnterpriseDelete===1}}" bindtap="deleteItem" data-item="{{item}}">删除</text><text class="action-btn delete" wx:if="{{item.userType===2 && permissions.permissionResearchDelete===1}}" bindtap="deleteItem" data-item="{{item}}">删除</text></view></view><view class="empty-box" wx:if="{{userList.length===0}}"><text class="empty-text">暂无数据</text></view></view></view><view wx:if="{{activeTab==='patent'}}"><view class="list"><view class="list-item patent-item" wx:for="{{patentList}}" wx:key="patentId"><view class="item-info" bindtap="openDetailModal" data-item="{{item}}"><text class="item-name">{{item.title}}</text><text class="item-meta">申请人: {{item.applicant}} | {{item.patentType}}</text><text class="item-meta">状态: {{item.legalStatus}} | {{item.validity}}</text></view><view class="item-actions"><text class="action-btn edit" wx:if="{{permissions.permissionPatentAudit===1}}" bindtap="openEditModal" data-item="{{item}}">编辑</text><text class="action-btn delete" wx:if="{{permissions.permissionPatentAudit===1}}" bindtap="deleteItem" data-item="{{item}}">删除</text></view></view><view class="empty-box" wx:if="{{patentList.length===0}}"><text class="empty-text">暂无数据</text></view></view></view><view class="pagination" wx:if="{{pages>1}}"><text class="page-btn {{pageNum<=1?'disabled':''}}" bindtap="onPrevPage">上一页</text><text class="page-info">{{pageNum}} / {{pages}}</text><text class="page-btn {{pageNum>=pages?'disabled':''}}" bindtap="onNextPage">下一页</text></view></view><view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal"><view class="modal-content" catchtap="preventBubble"><view class="modal-header"><text class="modal-title">{{modalTitleText}}</text><text class="modal-close" bindtap="closeModal">×</text></view><scroll-view class="modal-body" scroll-y><block wx:if="{{activeTab==='user'}}"><view wx:if="{{modalType==='detail'}}"><view class="detail-item"><text class="detail-label">用户名</text><text class="detail-value">{{currentItem.username}}</text></view><view class="detail-item"><text class="detail-label">昵称/姓名</text><text class="detail-value">{{currentItem.nickName}}</text></view><view class="detail-item"><text class="detail-label">用户类型</text><text class="detail-value">{{currentItem.userTypeLabel}}</text></view><view class="detail-item"><text class="detail-label">联系电话</text><text class="detail-value">{{currentItem.contactPhone}}</text></view><view class="detail-item"><text class="detail-label">联系邮箱</text><text class="detail-value">{{currentItem.contactEmail}}</text></view><view class="detail-item"><text class="detail-label">状态</text><text class="detail-value">{{currentItem.statusLabel}}</text></view><view class="detail-item"><text class="detail-label">注册时间</text><text class="detail-value">{{currentItem.createTime}}</text></view><view class="detail-item" wx:if="{{currentItem.companyName}}"><text class="detail-label">企业名称</text><text class="detail-value">{{currentItem.companyName}}</text></view><view class="detail-item" wx:if="{{currentItem.teamName}}"><text class="detail-label">团队名称</text><text class="detail-value">{{currentItem.teamName}}</text></view><view class="detail-item" wx:if="{{currentItem.institution}}"><text class="detail-label">所属机构</text><text class="detail-value">{{currentItem.institution}}</text></view></view><view wx:if="{{modalType==='create' || modalType==='edit'}}"><view class="form-item"><text class="form-label">用户名</text><input class="form-input" placeholder="请输入用户名" value="{{formData.username}}" data-field="username" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">真实姓名</text><input class="form-input" placeholder="请输入真实姓名" value="{{formData.realName}}" data-field="realName" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">联系电话</text><input class="form-input" placeholder="请输入联系电话" value="{{formData.contactPhone}}" data-field="contactPhone" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">联系邮箱</text><input class="form-input" placeholder="请输入联系邮箱" value="{{formData.contactEmail}}" data-field="contactEmail" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">状态</text><switch checked="{{formData.status===1}}" bindchange="onStatusChange"/></view></view></block><block wx:if="{{activeTab==='patent'}}"><view wx:if="{{modalType==='detail'}}"><view class="detail-item"><text class="detail-label">专利号</text><text class="detail-value">{{currentItem.patentId}}</text></view><view class="detail-item"><text class="detail-label">专利名称</text><text class="detail-value">{{currentItem.title}}</text></view><view class="detail-item"><text class="detail-label">申请人</text><text class="detail-value">{{currentItem.applicant}}</text></view><view class="detail-item"><text class="detail-label">发明人</text><text class="detail-value">{{currentItem.inventors}}</text></view><view class="detail-item"><text class="detail-label">专利类型</text><text class="detail-value">{{currentItem.patentType}}</text></view><view class="detail-item"><text class="detail-label">法律状态</text><text class="detail-value">{{currentItem.legalStatus}}</text></view><view class="detail-item"><text class="detail-label">有效性</text><text class="detail-value">{{currentItem.validity}}</text></view><view class="detail-item"><text class="detail-label">申请日</text><text class="detail-value">{{currentItem.applicationDate}}</text></view><view class="detail-item"><text class="detail-label">公开日</text><text class="detail-value">{{currentItem.publicationDate}}</text></view><view class="detail-item"><text class="detail-label">授权日</text><text class="detail-value">{{currentItem.grantDate}}</text></view><view class="detail-item"><text class="detail-label">摘要</text><text class="detail-value">{{currentItem.abstractText}}</text></view></view><view wx:if="{{modalType==='create' || modalType==='edit'}}"><view class="form-item"><text class="form-label">专利名称</text><input class="form-input" placeholder="请输入专利名称" value="{{formData.title}}" data-field="title" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">申请人</text><input class="form-input" placeholder="请输入申请人" value="{{formData.applicant}}" data-field="applicant" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">发明人</text><input class="form-input" placeholder="请输入发明人" value="{{formData.inventors}}" data-field="inventors" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">专利类型</text><input class="form-input" placeholder="请输入专利类型" value="{{formData.patentType}}" data-field="patentType" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">法律状态</text><input class="form-input" placeholder="请输入法律状态" value="{{formData.legalStatus}}" data-field="legalStatus" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">有效性</text><input class="form-input" placeholder="请输入有效性" value="{{formData.validity}}" data-field="validity" bindinput="onInputChange"/></view><view class="form-item"><text class="form-label">摘要</text><textarea class="form-textarea" placeholder="请输入专利摘要" value="{{formData.abstractText}}" data-field="abstractText" bindinput="onInputChange"/></view></view></block></scroll-view><view class="modal-footer"><button class="btn-cancel" bindtap="closeModal">取消</button><button class="btn-confirm" wx:if="{{modalType==='create' || modalType==='edit'}}" bindtap="submitForm">{{modalButtonText}}</button></view></view></view></view>
