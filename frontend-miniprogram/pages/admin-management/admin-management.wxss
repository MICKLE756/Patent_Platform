.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background: white;
  border-bottom: 1px solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 15px;
  color: #666;
  padding: 16px;
  border-bottom: 2px solid transparent;
}

.tab-item.active {
  color: #07c160;
  font-weight: 500;
  border-bottom-color: #07c160;
}

.toolbar {
  background: white;
  padding: 12px 16px;
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-filter {
  flex: 1;
  margin-right: 12px;
}

.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 40px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 0 12px;
  font-size: 14px;
  color: #333;
}

.picker-arrow {
  font-size: 12px;
  color: #999;
}

.add-btn {
  background-color: #07c160;
  color: white;
  font-size: 14px;
  padding: 8px 16px;
  border-radius: 4px;
}

.loading-box {
  text-align: center;
  padding: 40px;
}

.loading-text {
  color: #999;
  font-size: 14px;
}

.content {
  padding: 12px;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.list-item {
  background: white;
  border-radius: 8px;
  padding: 16px;
  display: flex;
  align-items: center;
}

.item-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: #07c160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 12px;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.item-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.item-meta {
  font-size: 12px;
  color: #999;
}

.item-actions {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}

.action-btn {
  font-size: 14px;
  padding: 4px 8px;
}

.action-btn.upgrade {
  color: #1890ff;
}

.action-btn.edit {
  color: #07c160;
}

.action-btn.delete {
  color: #ff4d4f;
}

.patent-item {
  padding: 16px;
}

.empty-box {
  text-align: center;
  padding: 60px 20px;
}

.empty-text {
  color: #999;
  font-size: 14px;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 16px;
}

.page-btn {
  font-size: 14px;
  color: #07c160;
  padding: 8px 16px;
}

.page-btn.disabled {
  color: #ccc;
}

.page-info {
  font-size: 14px;
  color: #666;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-width: 400px;
  max-height: 80vh;
  background: white;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #eee;
  flex-shrink: 0;
}

.modal-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 24px;
  color: #999;
  padding: 0 8px;
}

.modal-body {
  padding: 16px;
  flex: 1;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  font-size: 13px;
  color: #333;
  text-align: right;
  word-break: break-all;
}

.form-item {
  margin-bottom: 16px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  height: 40px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 0 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 100px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1px solid #eee;
  flex-shrink: 0;
}

.modal-footer button {
  flex: 1;
  border-radius: 0;
  font-size: 15px;
}

.btn-cancel {
  background: white;
  color: #666;
}

.btn-confirm {
  background: #07c160;
  color: white;
}