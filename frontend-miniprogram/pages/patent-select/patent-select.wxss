.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 10px;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 12px;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
}

.selected-count {
  font-size: 14px;
  color: #666;
}

.batch-btn {
  background: #07c160 !important;
  color: white !important;
  font-size: 13px !important;
  padding-left: 12px !important;
  padding-right: 12px !important;
  height: 32px !important;
  line-height: 32px !important;
}

.batch-btn::after {
  border: none;
}

.patent-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.patent-card {
  background: white;
  border-radius: 12px;
  padding: 14px;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
  position: relative;
  display: flex;
  gap: 12px;
  border: 2px solid transparent;
}

.patent-card.selected {
  border-color: #07c160;
  background: #f0fff4;
}

.check-box {
  width: 22px;
  height: 22px;
  border: 2px solid #ddd;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.check-box .checked {
  width: 18px;
  height: 18px;
  line-height: 18px;
  border-radius: 50%;
  background: #07c160;
  color: white;
  font-size: 12px;
  text-align: center;
}

.patent-content {
  flex: 1;
}

.patent-title {
  font-size: 14px;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.patent-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-item {
  font-size: 12px;
  color: #999;
}

.empty-box {
  background: white;
  border-radius: 12px;
  padding: 50px 10px 30px;
  text-align: center;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
}

.empty-text {
  font-size: 14px;
  color: #999;
  display: block;
}
