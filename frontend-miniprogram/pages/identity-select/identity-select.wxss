.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20px 16px;
}

.tip-text {
  font-size: 14px;
  color: #999;
  text-align: center;
  margin-bottom: 24px;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.card-item {
  background: white;
  border-radius: 16px;
  padding: 20px;
  position: relative;
  overflow: hidden;
}

.card-item::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
}

.card-item.enterprise::before {
  background: linear-gradient(180deg, #07c160, #06ad56);
}

.card-item.research::before {
  background: linear-gradient(180deg, #667eea, #764ba2);
}

.card-icon {
  font-size: 36px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 17px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
}

.card-desc {
  font-size: 13px;
  color: #999;
  line-height: 1.5;
  padding-right: 30px;
}

.card-arrow {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20px;
  color: #ccc;
}
