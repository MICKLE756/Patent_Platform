.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 16px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.add-btn {
  background-color: #07c160;
  color: white;
  font-size: 14px;
  padding: 8px 16px;
  border-radius: 4px;
}

.loading-box {
  text-align: center;
  padding: 40px;
}

.loading-text {
  color: #999;
  font-size: 14px;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.role-item {
  background: white;
  border-radius: 8px;
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.role-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.role-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.role-code {
  font-size: 12px;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 2px 6px;
  border-radius: 2px;
}

.role-desc {
  font-size: 13px;
  color: #666;
  margin-top: 4px;
}

.role-meta {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.role-actions {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}

.action-btn {
  font-size: 14px;
  padding: 4px 8px;
}

.action-btn.delete {
  color: #ff4d4f;
}

.action-btn.edit {
  color: #07c160;
}

.empty-box {
  text-align: center;
  padding: 60px 20px;
}

.empty-text {
  color: #999;
  font-size: 14px;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-width: 400px;
  max-height: 80vh;
  background: white;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-content.large {
  max-width: 500px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #eee;
  flex-shrink: 0;
}

.modal-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 24px;
  color: #999;
  padding: 0 8px;
}

.modal-body {
  padding: 16px;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 16px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  height: 40px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 0 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 80px;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.permission-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 300px;
  overflow-y: auto;
}

.permission-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.permission-item:last-child {
  border-bottom: none;
}

.permission-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.permission-label {
  font-size: 14px;
  color: #333;
}

.permission-level {
  font-size: 11px;
  color: #999;
  background: #f5f5f5;
  padding: 1px 4px;
  border-radius: 2px;
}

.permission-control {
  flex-shrink: 0;
}

.permission-locked {
  background: #f5f5f5;
  padding: 4px 8px;
  border-radius: 4px;
}

.locked-text {
  font-size: 12px;
  color: #999;
}

.permission-tip {
  font-size: 12px;
  color: #999;
  margin-top: 8px;
  display: block;
}

.permission-display {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.permission-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 2px;
}

.permission-status.enabled {
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
}

.permission-status.disabled {
  color: #999;
  background: #f5f5f5;
}

.detail-section {
  margin-bottom: 16px;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  font-size: 13px;
  color: #333;
  text-align: right;
  word-break: break-all;
}

.modal-footer {
  display: flex;
  border-top: 1px solid #eee;
  flex-shrink: 0;
}

.modal-footer button {
  flex: 1;
  border-radius: 0;
  font-size: 15px;
}

.btn-cancel {
  background: white;
  color: #666;
}

.btn-confirm {
  background: #07c160;
  color: white;
}