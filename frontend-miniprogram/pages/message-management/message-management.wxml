<view class="container">
  <view class="tabs">
    <text 
      class="tab-item {{activeTab === 'intention' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-key="intention"
      wx:if="{{permissions.permissionIntentionAudit === 1}}"
    >意向审核</text>
    <text 
      class="tab-item {{activeTab === 'notice' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-key="notice"
      wx:if="{{permissions.permissionNoticePublish === 1}}"
    >通知管理</text>
    <text 
      class="tab-item {{activeTab === 'log' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-key="log"
      wx:if="{{permissions.permissionLogView === 1}}"
    >系统日志</text>
  </view>

  <view class="toolbar" wx:if="{{activeTab === 'notice' && permissions.permissionNoticePublish === 1}}">
    <button class="add-btn" bindtap="openCreateNoticeModal">发布通知</button>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="content" wx:else>
    <view wx:if="{{activeTab === 'intention'}}">
      <view class="list">
        <view class="list-item" wx:for="{{intentionList}}" wx:key="intentionId">
          <view class="item-info">
            <text class="item-title">{{item.patentTitle || '未知专利'}}</text>
            <text class="item-meta">留言人: {{item.userName}} | {{item.createTime}}</text>
            <text class="item-content">{{item.content}}</text>
          </view>
          <view class="item-actions">
            <text class="action-btn approve" wx:if="{{permissions.permissionIntentionAudit === 1}}" bindtap="approveIntention" data-item="{{item}}">通过</text>
            <text class="action-btn reject" wx:if="{{permissions.permissionIntentionAudit === 1}}" bindtap="rejectIntention" data-item="{{item}}">拒绝</text>
          </view>
        </view>

        <view class="empty-box" wx:if="{{intentionList.length === 0}}">
          <text class="empty-text">暂无待审核意向</text>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'notice'}}">
      <view class="list">
        <view class="list-item" wx:for="{{noticeList}}" wx:key="id">
          <view class="item-info">
            <text class="item-title">{{item.title}}</text>
            <text class="item-meta">发布时间: {{item.publishTime}}</text>
            <text class="item-content">{{item.content}}</text>
          </view>
          <view class="item-actions">
            <text class="action-btn edit" bindtap="openEditNoticeModal" data-item="{{item}}">编辑</text>
            <text class="action-btn delete" bindtap="deleteNotice" data-item="{{item}}">删除</text>
          </view>
        </view>

        <view class="empty-box" wx:if="{{noticeList.length === 0}}">
          <text class="empty-text">暂无通知</text>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'log'}}">
      <view class="list">
        <view class="list-item log-item" wx:for="{{logList}}" wx:key="id">
          <view class="item-info">
            <text class="item-title">{{item.operation}} - {{item.module}}</text>
            <text class="item-meta">{{item.userName}} | {{item.operationTime}}</text>
            <text class="item-content">{{item.description}}</text>
          </view>
        </view>

        <view class="empty-box" wx:if="{{logList.length === 0}}">
          <text class="empty-text">暂无系统日志</text>
        </view>
      </view>
    </view>

    <view class="pagination" wx:if="{{pages > 1}}">
      <text class="page-btn {{pageNum <= 1 ? 'disabled' : ''}}" bindtap="onPrevPage">上一页</text>
      <text class="page-info">{{pageNum}} / {{pages}}</text>
      <text class="page-btn {{pageNum >= pages ? 'disabled' : ''}}" bindtap="onNextPage">下一页</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">{{modalType === 'create' ? '发布通知' : '编辑通知'}}</text>
        <text class="modal-close" bindtap="closeModal">×</text>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <view class="form-item">
          <text class="form-label">通知标题</text>
          <input class="form-input" placeholder="请输入通知标题" value="{{formData.title}}" data-field="title" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <text class="form-label">通知内容</text>
          <textarea class="form-textarea" placeholder="请输入通知内容" value="{{formData.content}}" data-field="content" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <text class="form-label">发布时间</text>
          <picker mode="date" value="{{formData.publishTime}}" bindchange="onInputChange" data-field="publishTime">
            <view class="form-input">{{formData.publishTime || '选择日期'}}</view>
          </picker>
        </view>
      </scroll-view>

      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="submitNotice">{{modalType === 'create' ? '发布' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>