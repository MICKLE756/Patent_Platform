<view class="container">
  <scroll-view class="msg-list" scroll-y scroll-into-view="msg-{{msgList.length-1}}" enhanced>
    <view wx:for="{{msgList}}" wx:key="index" id="msg-{{index}}">
      <view class="msg-item user-msg" wx:if="{{item.role === 'user'}}">
        <text class="msg-content">{{item.content}}</text>
      </view>
      
      <view class="msg-item ai-msg" wx:if="{{item.role === 'assistant'}}">
        <view class="ai-avatar">AI</view>
        <view class="msg-content">
          <text wx:if="{{item.content}}">{{item.content}}</text>
          
          <view class="patent-cards" wx:if="{{item.patents && item.patents.length > 0}}">
            <view class="patent-card" wx:for="{{item.patents}}" wx:key="id" wx:for-item="patent" bindtap="goToDetail" data-id="{{patent.id}}">
              <view class="patent-header">
                <text class="patent-name">{{patent.name}}</text>
                <text class="fit-rate">{{patent.fitRate}}% 适配</text>
              </view>
              <view class="patent-tags">
                <text class="tag" wx:for="{{patent.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
              </view>
              <view class="recommend-reason">
                <text class="label">推荐理由:</text>
                <text class="reason-text">{{patent.reason}}</text>
              </view>
              <view class="card-arrow">→</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="loading-msg" wx:if="{{loading}}">
      <view class="ai-avatar">AI</view>
      <view class="typing">
        <text class="dot"></text>
        <text class="dot"></text>
        <text class="dot"></text>
      </view>
    </view>
  </scroll-view>

  <view class="input-area">
    <input 
      class="input-box" 
      placeholder="请描述您的技术需求或问题..." 
      value="{{inputText}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="sendMessage"
    />
    <button class="send-btn" bindtap="sendMessage" disabled="{{loading || !inputText.trim()}}">发送</button>
  </view>
</view>
