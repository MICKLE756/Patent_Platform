.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}

.msg-list {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
}

.msg-item {
  display: flex;
  margin-bottom: 20px;
}

.user-msg {
  justify-content: flex-end;
}

.user-msg .msg-content {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  padding: 12px 16px;
  border-radius: 16px 16px 4px 16px;
  max-width: 70%;
  line-height: 1.6;
}

.ai-msg {
  justify-content: flex-start;
  align-items: flex-start;
}

.ai-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: white;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex-shrink: 0;
}

.ai-msg .msg-content {
  flex: 1;
  background: white;
  padding: 14px 16px;
  border-radius: 4px 16px 16px 16px;
  line-height: 1.6;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.patent-cards {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.patent-card {
  background: linear-gradient(135deg, #f0f7ff, #e6f0ff);
  border-radius: 12px;
  padding: 14px;
  position: relative;
  border: 1px solid #d6e8ff;
}

.patent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.patent-name {
  font-size: 15px;
  font-weight: 600;
  color: #1677ff;
  flex: 1;
  padding-right: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fit-rate {
  font-size: 12px;
  color: white;
  background: linear-gradient(135deg, #00b42a, #009a29);
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 500;
  white-space: nowrap;
}

.patent-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.patent-tags .tag {
  font-size: 11px;
  background: white;
  color: #1677ff;
  padding: 3px 10px;
  border-radius: 4px;
  border: 1px solid #bad6ff;
}

.recommend-reason {
  font-size: 12px;
  color: #666;
  line-height: 1.5;
}

.recommend-reason .label {
  color: #333;
  font-weight: 500;
  margin-right: 4px;
}

.card-arrow {
  position: absolute;
  right: 10px;
  bottom: 10px;
  color: #1677ff;
  font-size: 18px;
  opacity: 0.6;
}

.loading-msg {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.typing {
  background: white;
  padding: 14px 16px;
  border-radius: 4px 16px 16px 16px;
  margin-left: 10px;
  display: flex;
  gap: 4px;
}

.typing .dot {
  width: 6px;
  height: 6px;
  background: #999;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-6px); }
}

.input-area {
  background: white;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  gap: 10px;
  align-items: center;
  border-top: 1px solid #eee;
}

.input-box {
  flex: 1;
  background: #f5f7fa;
  border-radius: 20px;
  padding: 10px 16px;
  font-size: 14px;
  max-height: 100px;
}

.send-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 20px;
  font-size: 14px;
  padding: 0 20px;
  height: 40px;
  line-height: 40px;
  margin: 0;
  border: none;
}

.send-btn::after { border: none; }
.send-btn[disabled] { opacity: 0.5; }
