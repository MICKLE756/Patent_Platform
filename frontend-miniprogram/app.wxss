page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 20px;
}

.btn-primary {
  background-color: #1677ff;
  color: white;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  border: none;
}

.btn-primary:active {
  background-color: #0e5dcc;
}

.text-center {
  text-align: center;
}

.mt-20 {
  margin-top: 20px;
}

.mb-20 {
  margin-bottom: 20px;
}
